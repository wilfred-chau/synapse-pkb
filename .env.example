JIRA_SITE=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

DB_URL=jdbc:postgresql://127.0.0.1:5432/synapse_pkb
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

APP_JWT_SECRET=replace-with-at-least-32-characters
APP_JWT_EXPIRATION_MINUTES=720
APP_BOOTSTRAP_USERNAME=pkb-admin
APP_BOOTSTRAP_PASSWORD=replace-with-local-bootstrap-password
APP_BOOTSTRAP_DISPLAY_NAME=Wilfred
APP_BOOTSTRAP_SPACE_KEY=personal-space
APP_BOOTSTRAP_ENABLED=true

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# frontend/.env.local or the Vite process environment, not a VITE_* client variable
API_PROXY_TARGET=http://localhost:8080
