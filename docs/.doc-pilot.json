{
  "_comment": "doc-pilot 配置文件，由 scripts/init-kb.py 生成；skill 每次运行时读取本文件而非硬编码路径/前缀。",
  "project_name": "个人知识库系统（PKB）",
  "docs_root": "docs",
  "docs_language": "zh",
  "vcs": "git",
  "commit_message": {
    "language": "en",
    "conventional_commits": true
  },
  "ticket_system": {
    "enabled": true,
    "prefix": "SPKB",
    "gate_skill_path": ".trae/skills/dev-with-ticket/SKILL.md"
  },
  "requirements_source": {
    "enabled": true,
    "format": "docx"
  },
  "capacity_limits": {
    "dev_log_warn_lines": 1500,
    "dev_log_error_lines": 2000,
    "bugfix_log_max_lines": 1000,
    "bugfix_log_max_entries": 40,
    "status_max_lines": 150,
    "architecture_warn_lines": 400
  },
  "root_whitelist": [
    "README.md",
    "CLAUDE.md",
    "个人知识库系统PKB需求规格说明书.md"
  ],
  "created": "2026-09-05"
}
